msgid "Log out"
msgstr "Se déconnecter"

#: biblion/theme/templates/security/email/reset_instructions.html:5
#: biblion/theme/templates/security/email/reset_notice.html:5
msgid "Dear"
msgstr "Cher / chère"

#: biblion/theme/templates/security/email/reset_instructions.html:7
#: biblion/theme/templates/security/email/reset_notice.html:7
msgid "Dear patron"
msgstr "Cher lecteur / chère lectrice"

#: biblion/theme/templates/security/email/reset_instructions.html:9
msgid "Someone requested that the password for your Biblion ID account be reset."
msgstr ""
"Quelqu'un a demandé que le mot de passe de votre compte Biblion ID soit "
"réinitialisé."

#: biblion/theme/templates/security/email/reset_instructions.html:10
msgid "Reset my password"
msgstr "Réinitialiser mon mot de passe"

#: biblion/theme/templates/security/email/reset_instructions.html:11
msgid ""
"If you didn't request this, you can ignore this e-mail. Your password won't "
"change until you create a new password."
msgstr ""
"Si vous n'avez pas fait cette demande, vous pouvez ignorer cet e-mail. Votre "
"mot de passe ne changera pas tant que vous n'aurez pas créé de nouveau mot "
"de passe."

#: biblion/theme/templates/security/email/reset_instructions.html:12
#: biblion/theme/templates/security/email/reset_notice.html:10
msgid "Best regards"
msgstr "Meilleures salutations"

#: biblion/theme/templates/security/email/reset_instructions.html:13
#: biblion/theme/templates/security/email/reset_notice.html:11
msgid "Your library"
msgstr "Votre bibliothèque"

#: biblion/theme/templates/security/email/reset_notice.html:9
msgid "Your password has been successfully reset."
msgstr "Votre mot de passe a été réinitialisé avec succès."
