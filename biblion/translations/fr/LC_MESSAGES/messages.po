#: biblion/theme/templates/biblion/oauth/authorize.html:35
msgid "No permissions granted."
msgstr "Aucune permission donnée."

#: biblion/theme/templates/biblion/oauth/authorize.html:40
msgid "Your password is never shared with this application."
msgstr "Votre mot de passe n'est jamais partagé avec cette application."

#: biblion/theme/templates/biblion/oauth/authorize.html:48
msgid "Reject"
msgstr "Refuser"

#: biblion/theme/templates/biblion/oauth/authorize.html:53
#, python-format
msgid "You are signed in as %(account)s."
msgstr "Vous êtes connecté en tant que %(account)s."

