# Copy to .env and adjust. Every INVENIO_<NAME> variable overrides the <NAME>
# setting of biblion/config.py; the defaults below match docker-compose.yml.

# --- Flask / security --------------------------------------------------------
INVENIO_SECRET_KEY=change-me-to-a-long-random-string

# --- Services (PostgreSQL, Elasticsearch, Redis, RabbitMQ) ---------------------
INVENIO_SQLALCHEMY_DATABASE_URI=postgresql+psycopg2://biblion:biblion@localhost/biblion
INVENIO_SEARCH_ELASTIC_HOSTS=['localhost:9200']
INVENIO_CACHE_TYPE=redis
INVENIO_CACHE_REDIS_URL=redis://localhost:6379/0
INVENIO_ACCOUNTS_SESSION_REDIS_URL=redis://localhost:6379/1
INVENIO_CELERY_RESULT_BACKEND=redis://localhost:6379/2
INVENIO_RATELIMIT_STORAGE_URI=redis://localhost:6379/3
INVENIO_BROKER_URL=amqp://guest:guest@localhost:5672/
INVENIO_CELERY_BROKER_URL=amqp://guest:guest@localhost:5672/

# --- Biblion -------------------------------------------------------------------
# Host of the MEF authority server used to link persons, subjects and places.
BIBLION_MEF_REF_BASE_URL=mef.rero.ch
# Folder where scripts/setup stores the uploaded document files.
INVENIO_BIBLION_FILES_FOLDER=data/files

# Optional fixed API tokens created by scripts/setup (leave empty to generate them).
INVENIO_BIBLION_ACCESS_TOKEN_MONITORING=
INVENIO_BIBLION_ACCESS_TOKEN_NGSCAN=
INVENIO_BIBLION_ACCESS_TOKEN_AOSTA_LIBRARIAN=
INVENIO_BIBLION_ACCESS_TOKEN_SCOLAND_LIBRARIAN=
INVENIO_BIBLION_ACCESS_TOKEN_FICTIVE_LIBRARIAN=
